{
  "name": "theruiz-aura-visual-prompt-generator",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "validate:prompts": "node scripts/validatePromptAuthenticity.mjs",
    "validate:studio": "node scripts/validateStudioSceneWardrobe.mjs",
    "validate:engine": "node scripts/validatePromptEngine.mjs",
    "validate:atmosphere": "node scripts/validateNonProductAtmosphereModule.mjs",
    "validate:actions": "node scripts/validateSoftSeedingActionDiversity.mjs",
    "validate:outfits": "node scripts/validateOutfitCombinationDiversity.mjs",
    "validate:production-runtime": "node scripts/validateProductionRuntime.mjs",
    "validate:reference-binding": "node scripts/validateReferenceBinding.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.15",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^7.3.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3"
  }
